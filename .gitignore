.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.spec

# Служебные заметки оркестратора: состояние работы, а не артефакт задачи.
tasks/*.progress

# Бандл орка: исходный код инструмента в репозиторий не попадает — он
# ставится отдельно (bash ~/orch/bin/vendor-orch.sh .), а в открытом
# репозитории ему не место.
.orch/

# Нормативная модель орка — тоже проприетарное содержимое: в репозитории её
# нет. Ссылка (не копия) нужна глобально установленному орку, чтобы он
# искал модель у себя, а per-task спецификацию писал в проект, а не в
# site-packages. Подробности и команда — в docs/ba/spec/README.md.
docs/ba/spec/model
